{
  "name": "ai-studio-twitter-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "npm run cf-typegen"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "rclone.js": "0.6.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
